    <item>
      <title>1.0</title>
      <pubDate>Mon, 07 Sep 2026 21:00:00 +0000</pubDate>
      <sparkle:version>1</sparkle:version>
      <sparkle:shortVersionString>1.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>26.0</sparkle:minimumSystemVersion>
      <description><![CDATA[
        <h3>First public release</h3>
        <ul>
          <li>Records Slack, Google Meet, or the full screen via ScreenCaptureKit</li>
          <li>On-device transcription with whisper.cpp, speaker labels without diarization</li>
          <li>Optional call summaries through the Claude CLI</li>
          <li>Global ⌘⇧R hotkey and searchable history</li>
        </ul>
      ]]></description>
