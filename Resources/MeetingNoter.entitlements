<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime blocks microphone access unless it is requested explicitly.
	     Screen recording needs no entitlement — it goes through TCC alone. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
